AETHER_ENV=development

# Groq API
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_CONCURRENCY=8

# Environment-specific model routing
# production: factor/support -> mixtral-8x7b-32768, opposition/synthesis -> llama-3.1-70b-versatile
# staging: all agents can default to mixtral-8x7b-32768
GROQ_MODEL_PROFILES_JSON={"production":{"factor_extractor":"mixtral-8x7b-32768","support":"mixtral-8x7b-32768","opposition":"llama-3.1-70b-versatile","synthesis":"llama-3.1-70b-versatile","fallback_models":["mixtral-8x7b-32768","llama-3.1-70b-versatile"]},"staging":{"factor_extractor":"mixtral-8x7b-32768","support":"mixtral-8x7b-32768","opposition":"mixtral-8x7b-32768","synthesis":"mixtral-8x7b-32768","fallback_models":["mixtral-8x7b-32768","llama-3.1-70b-versatile"]}}

# Rate limit thresholds
GROQ_RATE_LIMIT_RPM_PROD=1200
GROQ_RATE_LIMIT_RPM_STAGING=300
GROQ_RATE_LIMIT_RPM_DEV=120
GROQ_RATE_LIMIT_ALERT_THRESHOLD=0.8
GROQ_ERROR_RATE_ALERT_THRESHOLD=0.05
GROQ_HEALTH_ERROR_RATE_THRESHOLD=0.10
GROQ_CACHE_HIT_ALERT_FLOOR=0.25

# Optional pricing for cost tracking (USD per 1M tokens)
GROQ_MODEL_PRICING_JSON={"mixtral-8x7b-32768":{"input_per_1m":0.27,"output_per_1m":0.27},"llama-3.1-70b-versatile":{"input_per_1m":0.59,"output_per_1m":0.79}}

# SMTP for emailing reports from the UI (optional; skip to leave email disabled)
AETHER_SMTP_HOST=smtp.gmail.com
AETHER_SMTP_PORT=587
AETHER_SMTP_USER=your_smtp_username
AETHER_SMTP_PASSWORD=your_smtp_password_or_app_password
AETHER_SMTP_FROM=aether@example.com
AETHER_SMTP_STARTTLS=1
